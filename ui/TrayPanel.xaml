<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iCUE Scheduler Tray" Width="360" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Left="-10000" Top="-10000"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources><!--THEME--></Window.Resources>
  <Border Margin="10" CornerRadius="14" Background="#F51B1D25" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="16,14">
    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#000000"/></Border.Effect>
    <StackPanel>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="AppIcon" Width="16" Height="16" Margin="0,0,8,0"/>
          <TextBlock x:Name="L_Title" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
        </StackPanel>
        <ToggleButton x:Name="TglAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
      </Grid>
      <TextBlock x:Name="CurName" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Fg}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="CurWhen" Style="{StaticResource Muted}" Margin="0,3,0,12"/>
      <ContentControl x:Name="MiniTL" HorizontalContentAlignment="Stretch" Margin="0,0,0,14"/>
      <UniformGrid x:Name="Tiles" Columns="2" Margin="-3,0,-3,10"/>
      <ContentControl x:Name="Bright" HorizontalContentAlignment="Stretch"/>
      <TextBlock x:Name="Status" Foreground="#B9AEFF" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="BtnOpen" Style="{StaticResource Btn}"/>
        <Button x:Name="BtnApply" Grid.Column="2" Style="{StaticResource Btn}"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>